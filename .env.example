# Gmail SMTP Configuration for Real Email OTP Dispatch
# NOTE: Google requires a 16-character App Password (not your standard Gmail account password).
# Steps to generate:
# 1. Open Google Account (myaccount.google.com) -> Security -> 2-Step Verification
# 2. Select 'App passwords' (or visit: https://myaccount.google.com/apppasswords)
# 3. Create an app named 'SSEC IT Portal' and copy the 16-character password.
# 4. Set MAIL_USERNAME to your full Gmail address (e.g., nexoratechnologiessupport@gmail.com).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nexoratechnologiessupport@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=nexoratechnologiessupport@gmail.com
OTP_EXPIRY_MINUTES=5

# Gemini API Key (If AI optimizations are enabled)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
